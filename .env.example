# Copie para .env na raiz ou em controller/ (não versionar).
# Em produção o instalador leva a chave via resources/runtime-env.json (gerado no build).

INVB_SUPABASE_ANON_KEY=
# Opcional — default aponta para o REST de músicas do projeto INVB
# INVB_SUPABASE_URL=https://rosvseljurczmzdycbxs.supabase.co/rest/v1/musicas?select=*&order=nome.asc

# Chave só de leitura do banco online (Authorization: Bearer). A mesma LYRA_API_KEY do site.
# Sem ela, «Sincronizar com Lyra» não encontra músicas.
LYRA_API_KEY=

# Opcional — sync de tons pela API na nuvem (services/invb-webhook-api) em vez do Supabase direto.
# Só é aceita se for HTTPS e de um subdomínio de onrender.com ou invbotafogo.com.br, sem
# porta, usuário, query ou fragmento. A URL NÃO vem mais do corpo da requisição.
# INVB_TONS_SYNC_URL=https://invb-webhook-api.onrender.com
# Hosts extras permitidos (nomes exatos, separados por vírgula; continua exigindo HTTPS).
# INVB_TONS_SYNC_HOSTS=

# Opcional — habilita POST /api/tom-memoria/webhook-invb. Sem esta variável a rota
# responde 503 (desativada). O Supabase deve enviar o mesmo valor no cabeçalho x-lyra-webhook-secret.
# LYRA_INVB_WEBHOOK_SECRET=
