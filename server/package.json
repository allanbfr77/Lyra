{
  "name": "lyra-server",
  "version": "0.0.0",
  "description": "Servidor Lyra — gerencia telas e recebe comandos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon src/main.js",
    "postinstall": "electron-rebuild",
    "prebuild:win": "node ../tools/gerar-server-build.js",
    "build:win": "electron-builder --win nsis && node ../tools/gerar-server-latest-yml.js",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@lyra/projection-core": "file:../packages/projection-core",
    "better-sqlite3": "^12.9.0",
    "express": "^4.18.3",
    "socket.io": "4.7.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "br.org.lyra.server",
    "productName": "Lyra Servidor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "../brand/lyra-server.ico",
        "to": "brand/lyra-server.ico"
      },
      {
        "from": "../brand/lyra-server-512.png",
        "to": "brand/lyra-server-512.png"
      },
      {
        "from": "resources/server-build.json",
        "to": "server-build.json"
      }
    ],
    "icon": "../brand/lyra-server-512.png",
    "mac": {
      "icon": "../brand/lyra-server-512.png"
    },
    "linux": {
      "icon": "../brand/lyra-server-512.png"
    },
    "win": {
      "icon": "../brand/lyra-server.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Lyra-Servidor-Setup.${ext}"
    },
    "nsis": {
      "installerIcon": "../brand/lyra-server.ico",
      "uninstallerIcon": "../brand/lyra-server.ico",
      "installerHeaderIcon": "../brand/lyra-server.ico"
    }
  }
}
