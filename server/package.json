{
  "name": "lyra-server",
  "version": "1.0.3",
  "description": "Servidor Lyra — gerencia telas e recebe comandos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon src/main.js",
    "postinstall": "electron-rebuild",
    "build:win": "electron-builder --win nsis",
    "publish:win": "electron-builder --win nsis --publish always",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.3.9",
    "express": "^4.18.3",
    "socket.io": "4.7.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "br.org.lyra.server",
    "productName": "Lyra Servidor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../brand/lyra-server.ico",
        "to": "brand/lyra-server.ico"
      },
      {
        "from": "../brand/lyra-server-512.png",
        "to": "brand/lyra-server-512.png"
      }
    ],
    "icon": "../brand/lyra-server-512.png",
    "mac": {
      "icon": "../brand/lyra-server-512.png"
    },
    "linux": {
      "icon": "../brand/lyra-server-512.png"
    },
    "win": {
      "icon": "../brand/lyra-server.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Lyra-Servidor-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "../brand/lyra-server.ico",
      "uninstallerIcon": "../brand/lyra-server.ico",
      "installerHeaderIcon": "../brand/lyra-server.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "allanbfr77",
      "repo": "allanbfr77-new-holyrics-server-updates",
      "releaseType": "release"
    }
  }
}
