{
  "name": "lyra",
  "version": "1.0.0",
  "private": true,
  "description": "Lyra — servidor, controlador e mobile",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix controller\"",
    "test": "node --test server/src/lib/controleAcesso.test.js server/src/lib/persistenciaEstado.test.js controller/src/lib/indiceMusicasBusca.test.js",
    "test:mobile": "npm test --prefix mobile",
    "catalog:build": "node tools/gerar-catalog.js",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:brand-icons": "node scripts/generate-brand-icons.js",
    "lint": "eslint server/src/**/*.js controller/src/**/*.js controller/public/js/**/*.js",
    "lint:fix": "eslint --fix server/src/**/*.js controller/src/**/*.js controller/public/js/**/*.js"
  },
  "devDependencies": {
    "@fiahfy/icns": "^0.0.7",
    "@fiahfy/ico": "^0.0.5",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  }
}
